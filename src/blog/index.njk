---
layout: layouts/base.njk
title: News & Updates
description: News and updates on personal injury care coordination, provider networks, and treatment visibility from PrimeCare Network.
permalink: /blog/
pagination:
  data: collections.blog
  size: 12
  alias: posts
eleventyComputed:
  activeNav: blog
---

<section class="page-hero page-hero--blog">
  <div class="container">
    <p class="page-hero__eyebrow">From PrimeCare</p>
    <h1>News &amp; Updates</h1>
    <p class="page-hero__lede">Practical guidance on provider access, care coordination, and keeping personal injury treatment moving.</p>
  </div>
</section>

<section class="section section--muted">
  <div class="container">
    {% if posts.length === 0 %}
      <div class="section__head">
        <h2>Posts coming soon</h2>
        <p>New articles will appear here as they are published from the CMS.</p>
      </div>
    {% else %}
      <div class="blog-tiles">
        {% for post in posts %}
          <article class="blog-tile reveal">
            <a class="blog-tile__link" href="{{ post.url | url }}">
              <div class="blog-tile__media">
                {% if post.data.image %}
                  <img
                    src="{{ post.data.image | url }}"
                    alt="{{ post.data.imageAlt or post.data.title }}"
                    loading="lazy"
                    width="640"
                    height="400"
                  />
                {% else %}
                  <div class="blog-tile__placeholder" aria-hidden="true"></div>
                {% endif %}
              </div>
              <div class="blog-tile__body">
                <p class="blog-tile__meta">
                  <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
                  {% if post.data.author %}<span aria-hidden="true">·</span> {{ post.data.author }}{% endif %}
                </p>
                <h2 class="blog-tile__title">{{ post.data.title }}</h2>
                {% if post.data.summary %}
                  <p class="blog-tile__summary">{{ post.data.summary }}</p>
                {% endif %}
                <span class="blog-tile__cta">Read article</span>
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      {% if pagination.href.previous or pagination.href.next %}
        <nav class="blog-pagination" aria-label="News pages">
          {% if pagination.href.previous %}
            <a class="btn btn--outline btn--sm" href="{{ pagination.href.previous | url }}">Previous</a>
          {% endif %}
          {% if pagination.href.next %}
            <a class="btn btn--outline btn--sm" href="{{ pagination.href.next | url }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endif %}
  </div>
</section>
