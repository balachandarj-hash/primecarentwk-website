---
layout: layouts/base.njk
permalink: /doctors/
pageTitle: Providers Directory | PrimeCare Network
description: Search PrimeCare Network providers by name, specialty, city, and state. Book an appointment with a patient coordinator.
activeNav: doctors
---

<section class="doctors-hero doctors-hero--with-slider" aria-labelledby="doctors-hero-title">
  <div class="container">
    <div class="doctors-hero__inner reveal">
      <p class="eyebrow">Providers Directory</p>
      <h1 id="doctors-hero-title">Find a PrimeCare Network provider</h1>
      <p class="lede">
        Browse featured providers below, or search the full multi-specialty network by name,
        specialty, state, and city.
      </p>
    </div>

    <div
      class="top-providers doctors-hero__slider reveal"
      data-top-providers-slider
      data-tp-src="{{ '/assets/data/top-providers.json' | url }}"
    >
      <div class="top-providers__viewport">
        <div class="top-providers__track"></div>
      </div>
      <div class="top-providers__controls">
        <button type="button" class="top-providers__btn" data-tp-prev aria-label="Previous providers">‹</button>
        <div class="top-providers__dots" data-tp-dots aria-hidden="true"></div>
        <button type="button" class="top-providers__btn" data-tp-next aria-label="Next providers">›</button>
      </div>
    </div>
  </div>
</section>

<section class="doctors-search" aria-label="Search for providers">
  <div class="container">
    <div class="doctors-search__panel">
      <div class="doctors-search__title">Search for Providers</div>
      <form class="doctors-search__form" id="doctors-filter-form">
        <label class="doctors-field doctors-field--name">
          <span class="doctors-field__label">Provider name</span>
          <input
            id="filter-name"
            name="name"
            type="search"
            placeholder="Search by provider name"
            autocomplete="off"
            enterkeyhint="search"
          />
        </label>
        <label class="doctors-field">
          <span class="doctors-field__label">Specialty</span>
          <select id="filter-specialty" name="specialty">
            <option value="">Select specialties</option>
            {% for item in providersDirectory.specialties %}
            <option value="{{ item }}">{{ item }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="doctors-field">
          <span class="doctors-field__label">State</span>
          <select id="filter-state" name="state">
            <option value="">Select states</option>
            {% for item in providersDirectory.states %}
            <option value="{{ item }}">{{ item }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="doctors-field">
          <span class="doctors-field__label">City</span>
          <select id="filter-city" name="city" disabled>
            <option value="">Select a state first</option>
          </select>
        </label>
        <button class="btn btn--primary doctors-search__submit" type="submit">Search</button>
      </form>
    </div>
  </div>
</section>

<section class="doctors-results" aria-live="polite">
  <div class="container">
    <div class="doctors-results__meta">
      <p id="doctors-results-count"></p>
      <button class="text-link" type="button" id="doctors-clear-filters" hidden>Clear filters</button>
    </div>
    <div id="doctors-results-list" class="doctors-list"></div>
    <nav class="doctors-pagination" id="doctors-pagination" aria-label="Provider results pages"></nav>
  </div>
</section>

<script type="application/json" id="doctors-data">{{ providersDirectory.providers | dump | safe }}</script>
<script type="application/json" id="doctors-cities-by-state">{{ providersDirectory.citiesByState | dump | safe }}</script>
<script>
  window.PRIMCARE_BASE = "{{ '/' | url }}";
</script>
<script src="{{ '/js/doctors-directory.js' | url }}" defer></script>
<script src="{{ '/js/top-providers.js' | url }}" defer></script>

{% include "partials/appointment-modal.njk" %}
