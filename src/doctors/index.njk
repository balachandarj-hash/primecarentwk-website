---
layout: layouts/base.njk
permalink: /doctors/
pageTitle: Providers Directory | PrimeCare Network
description: Search PrimeCare Network providers by name, specialty, city, and state on an interactive map directory.
activeNav: doctors
bodyClass: doctors-page doctors-map-directory
---

<section class="doctors-directory" id="doctors-directory" aria-label="Provider map directory">
  <h1 class="sr-only">Find a PrimeCare Network provider</h1>

  <div
    id="doctors-map"
    class="doctors-map doctors-directory__map"
    role="region"
    aria-label="Map of PrimeCare Network provider addresses"
    data-locations-src="{{ '/assets/data/provider-locations.json' | url }}"
  ></div>

  <div class="doctors-directory__ui">
    <div class="doctors-directory__search" aria-label="Search for providers">
      <form class="doctors-directory__form" id="doctors-filter-form">
        <label class="doctors-directory__query">
          <span class="sr-only">Provider name</span>
          <input
            id="filter-name"
            name="name"
            type="search"
            placeholder="Search providers, specialty, or city"
            autocomplete="off"
            enterkeyhint="search"
          />
        </label>
        <button
          class="doctors-filters-toggle"
          type="button"
          id="doctors-filters-toggle"
          aria-expanded="false"
          aria-controls="doctors-search-filters"
        >
          Filters
        </button>
        <button class="btn btn--primary doctors-directory__submit" type="submit">Search</button>
      </form>

      <div class="doctors-directory__filters" id="doctors-search-filters" hidden>
        <label class="doctors-field">
          <span class="doctors-field__label">Specialty</span>
          <select id="filter-specialty" name="specialty" form="doctors-filter-form">
            <option value="">All specialties</option>
            {% for item in providersDirectory.specialties %}
            <option value="{{ item }}">{{ item }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="doctors-field">
          <span class="doctors-field__label">State</span>
          <select id="filter-state" name="state" form="doctors-filter-form">
            <option value="">All states</option>
            {% for item in providersDirectory.states %}
            <option value="{{ item }}">{{ item }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="doctors-field">
          <span class="doctors-field__label">City</span>
          <select id="filter-city" name="city" form="doctors-filter-form" disabled>
            <option value="">Select a state first</option>
          </select>
        </label>
      </div>

      <div class="doctors-directory__meta-bar">
        <p id="doctors-map-count" class="doctors-directory__map-count">Loading map…</p>
        <p id="doctors-results-count" class="doctors-directory__results-count"></p>
        <button class="text-link" type="button" id="doctors-clear-filters" hidden>Clear</button>
      </div>
    </div>

    <aside class="doctors-directory__panel" id="doctors-results" aria-live="polite">
      <div class="doctors-directory__panel-head">
        <div class="doctors-results__handle" aria-hidden="true"></div>
        <div class="doctors-directory__panel-title-row">
          <strong>Providers</strong>
          <div class="doctors-view-toggle" role="group" aria-label="Panel size">
            <button type="button" class="doctors-view-toggle__btn is-active" data-sheet-size="peek" aria-pressed="true">
              Map
            </button>
            <button type="button" class="doctors-view-toggle__btn" data-sheet-size="half" aria-pressed="false">
              Split
            </button>
            <button type="button" class="doctors-view-toggle__btn" data-sheet-size="full" aria-pressed="false">
              List
            </button>
          </div>
        </div>
      </div>
      <div class="doctors-directory__panel-body">
        <div id="doctors-results-list" class="doctors-list"></div>
        <nav class="doctors-pagination" id="doctors-pagination" aria-label="Provider results pages"></nav>
      </div>
    </aside>
  </div>
</section>

<script type="application/json" id="doctors-data">{{ providersDirectory.providers | dump | safe }}</script>
<script type="application/json" id="doctors-cities-by-state">{{ providersDirectory.citiesByState | dump | safe }}</script>
<script>
  window.PRIMCARE_BASE = "{{ '/' | url }}";
</script>
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
  defer
></script>
<script src="{{ '/js/doctors-directory.js' | url }}" defer></script>
<script src="{{ '/js/doctors-map.js' | url }}" defer></script>
<script src="{{ '/js/doctors-explorer.js' | url }}" defer></script>

{% include "partials/appointment-modal.njk" %}
