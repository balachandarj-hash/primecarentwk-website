<div class="appt-modal" id="appt-modal" hidden>
  <div class="appt-modal__backdrop" data-appt-close></div>
  <div
    class="appt-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="appt-modal-title"
  >
    <button class="appt-modal__close" type="button" data-appt-close aria-label="Close">&times;</button>
    <h2 id="appt-modal-title">Schedule your Appointment</h2>
    <p class="appt-modal__lede">
      Send your details so our Patient Coordinator can get back to you.
    </p>
    <form class="appt-form" id="appt-form">
      <input type="hidden" name="provider" id="appt-provider" value="" />
      <label>
        <span>Name</span>
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        <span>Phone Number</span>
        <input type="tel" name="phone" required autocomplete="tel" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="3" placeholder="Preferred times, injury type, or questions"></textarea>
      </label>
      <div class="form__sms">
        <p class="form__sms-title">SMS Consent</p>
        <label class="form__sms-label">
          <input type="checkbox" name="sms_opt_in" value="1" />
          <span>
            By checking this box, I consent to receive text messages related to conversations
            (external) and conversations (between employees) from PrimeCare Network, LLC. You can
            reply “STOP” at any time to opt out. Message and data rates may apply. Message frequency
            may vary. Text HELP to <a href="tel:8884748473">888-474-8473</a> for assistance. For more
            information, please refer to our privacy policy
            <a href="{{ '/privacy-policy.html' | url }}">Privacy Policy</a>, and SMS terms and
            conditions
            <a href="{{ '/about-primecare/terms-conditions/' | url }}">Terms &amp; Conditions</a>, on
            our website
            <a href="https://primecarentwk.com/index.html">https://primecarentwk.com/index.html</a>.
          </span>
        </label>
      </div>
      <button class="btn btn--primary" type="submit">Send</button>
      <p class="appt-form__note" id="appt-form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</div>
