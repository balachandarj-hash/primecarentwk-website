<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if pageTitle %}{{ pageTitle }}{% elseif title %}{{ title }}{% if not title.includes("PrimeCare") %} | {{ site.name }}{% endif %}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta property="og:title" content="{{ pageTitle or title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/assets/images/logo-light.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{ '/css/styles.css' | url }}" />
    <script>
      (function () {
        var path = location.pathname;
        if (path.indexOf(".html") === -1 && path.slice(-1) !== "/") {
          location.replace(path + "/" + location.search + location.hash);
        }
      })();
    </script>
  </head>
  <body>
    {% include "partials/topbar.njk" %}
    {% include "partials/header.njk" %}
    <main>
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="{{ '/js/main.js' | url }}"></script>
  </body>
</html>
